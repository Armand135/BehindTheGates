# Database (Postgres - Supabase/Neon in production)
# On Supabase, use the pooler host (Supavisor) for BOTH, not the raw
# "Direct connection" (db.<ref>.supabase.co) — that host resolves IPv6-only,
# which most serverless platforms (including Vercel by default) can't reach.
# DATABASE_URL: Transaction pooler, port 6543, for app runtime (?pgbouncer=true
#   disables prepared-statement caching, required in pgbouncer transaction mode).
# DIRECT_URL: Session pooler, same host, port 5432, used only for
#   `prisma migrate deploy` (pgbouncer transaction mode can't run migrations).
DATABASE_URL="postgresql://user:password@localhost:5432/behind_the_gates"
DIRECT_URL="postgresql://user:password@localhost:5432/behind_the_gates"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Percentage (e.g. 15 = 15%) the platform keeps as commission on paid bookings.
PLATFORM_COMMISSION_PCT="15"

# Email (Resend)
RESEND_API_KEY=""
NOTIFICATIONS_FROM_EMAIL="bookings@behindthegates.com"

# File storage (S3-compatible / Supabase Storage)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
