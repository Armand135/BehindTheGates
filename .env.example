# Database (Postgres - Supabase/Neon in production)
# DATABASE_URL: pooled connection (Supabase's pgbouncer, port 6543) for app runtime.
# DIRECT_URL: unpooled connection (port 5432) used only for `prisma migrate deploy`.
# On Supabase both come from Project Settings > Database > Connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/behind_the_gates"
DIRECT_URL="postgresql://user:password@localhost:5432/behind_the_gates"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Percentage (e.g. 15 = 15%) the platform keeps as commission on paid bookings.
PLATFORM_COMMISSION_PCT="15"

# Email (Resend)
RESEND_API_KEY=""
NOTIFICATIONS_FROM_EMAIL="bookings@behindthegates.com"

# File storage (S3-compatible / Supabase Storage)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
