# --- Database ---
POSTGRES_USER=portcopilot
POSTGRES_PASSWORD=portcopilot
POSTGRES_DB=portcopilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://portcopilot:portcopilot@postgres:5432/portcopilot

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Backend ---
BACKEND_CORS_ORIGINS=http://localhost:3000
SIMULATION_TICK_SECONDS=1.0
SIMULATION_DEFAULT_ACCELERATION=60

# --- AI Copilot ---
# Optional: without a key, the copilot falls back to a deterministic
# retrieval-only mode (no free-text generation).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
